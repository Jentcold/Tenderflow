# Copy to .env and fill in. Every key below has a default in app/config.py
# except DATABASE_URL and JWT_SECRET, which are required.

DATABASE_URL=postgresql+asyncpg://tenderflow:tenderflow@localhost:5432/tenderflow
DATABASE_URL_SYNC=postgresql+psycopg2://tenderflow:tenderflow@localhost:5432/tenderflow

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# "*" lets a file:// page (no origin) talk to the API without a web server.
CORS_ORIGINS=*
FRONTEND_BASE_URL=http://localhost:5500

# IANA name for every timestamp and deadline the app produces. Empty uses the
# server's own local zone, which is fine on one machine but drifts the day you
# deploy somewhere set to UTC. Name it once you know where this will run.
#   SERVER_TIMEZONE=Africa/Cairo
SERVER_TIMEZONE=

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@tenderflow.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=System Administrator

# ------------------------------------------------------------------ limits --
RATE_LIMIT_ENABLED=true
# Only enable behind a reverse proxy you control — clients can forge this header.
TRUST_PROXY_HEADERS=false

LOGIN_RATE_LIMIT_TIMES=10
LOGIN_RATE_LIMIT_SECONDS=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

VENDOR_READ_RATE_LIMIT_TIMES=60
VENDOR_READ_RATE_LIMIT_SECONDS=60
VENDOR_SUBMIT_RATE_LIMIT_TIMES=5
VENDOR_SUBMIT_RATE_LIMIT_SECONDS=3600

# ------------------------------------------------------------------- email --
# Leave SMTP_HOST empty to keep award emails simulated (rendered + logged,
# never delivered). Fill it in to send for real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=30

MAIL_FROM=noreply@tenderflow.com
MAIL_FROM_NAME=TenderFlow
MAIL_MAX_ATTEMPTS=3

# Testing only. Set it and EVERY vendor email is rerouted to this address, with
# the real recipient kept in the subject line and an X-Original-To header. Lets
# you exercise a live award without mailing the vendors. LEAVE EMPTY IN
# PRODUCTION — with it set, no vendor ever receives anything.
MAIL_REDIRECT_TO=

# Gmail example (needs an App Password, not the account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   MAIL_FROM=you@gmail.com
