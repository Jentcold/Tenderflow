# --- Secrets -----------------------------------------------------------
# .env.example is the tracked template and must stay placeholder-only.
.env
.env.*
!.env.example

# Keys, certificates, service-account files
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
*credentials*.json
*service-account*.json
secrets.*
.netrc
.pgpass

# --- Data ---------------------------------------------------------------
# Vendor-uploaded bid documents: real company data, not source.
backend/uploads/

# Local databases and dumps — these carry live rows, including password hashes.
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
*.bak

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.Python
build/
dist/

# --- Tooling ------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors / OS -------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Logs ---------------------------------------------------------------
*.log
logs/


# --- Local-only ---------------------------------------------------------
# Throwaway invite links pasted out of the log during testing.
links.txt
# Cached login tokens written by the manual test scripts.
tokens.json
# Seeds one account per desk, all sharing one hardcoded password.
backend/dev_accounts.py
# Editor/agent state, not source.
.claude/